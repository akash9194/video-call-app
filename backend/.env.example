# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=freelance_app

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - comma separated origins, use * only in dev
CORS_ORIGINS=*

# TURN/STUN (see docs/BUILD_GUIDE.md for how to fill these in)
# Free public STUN is fine for dev. For production behind mobile networks/NAT
# you MUST run your own TURN server (coturn) or calls will fail to connect.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=turn:your-turn-server.com:3478
TURN_USERNAME=
TURN_CREDENTIAL=
