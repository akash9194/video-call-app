# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=freelance_app

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - comma separated origins, use * only in dev
CORS_ORIGINS=*

# TURN/STUN -- see docs/TURN_SERVER_SETUP.md for how to stand up the TURN
# server itself (infra/coturn/turnserver.conf) and fill these in. Free
# public STUN is fine for dev. For production, behind real mobile
# networks/NATs, you MUST run your own TURN server or a meaningful share of
# calls will simply fail to connect.
STUN_URLS=stun:stun.l.google.com:19302
# Comma-separated; include udp, tcp, and (recommended) a TLS variant so
# calls can still connect from networks that block plain UDP/TCP TURN.
TURN_URLS=turn:your-turn-server.com:3478?transport=udp,turn:your-turn-server.com:3478?transport=tcp,turns:your-turn-server.com:5349?transport=tcp
# Must exactly match `static-auth-secret` in turnserver.conf on the TURN
# server. The backend uses this to mint short-lived per-user credentials
# (see Settings.turn_credentials in app/config.py) -- never a static
# username/password shipped in the app.
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600
